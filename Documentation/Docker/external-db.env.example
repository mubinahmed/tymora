# Settings for docker-compose.external-db.yml (copy to external-db.env and edit; keep external-db.env out of git).
#
# JDBC URL of the external database. A server on the Docker host: host.docker.internal. Over the network, prefer
# useSSL=true (with sslMode / trust settings as your server needs); allowPublicKeyRetrieval=true is only for
# MySQL 8 caching_sha2 logins without SSL.
DB_URL=jdbc:mysql://host.docker.internal:3306/timetable?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf-8
DB_USER=timetable
# Either the password itself (any characters) ...
DB_PASSWORD=change-me
# ... or a file holding it, mounted into unitime-web (then leave DB_PASSWORD empty), e.g. a Docker secret:
# DB_PASSWORD_FILE=/run/secrets/tymora_db_password
# Seconds to wait for the database host and port before Tymora starts (default 120).
# DB_WAIT_SECONDS=120
