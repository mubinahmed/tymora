{
  "//": "Dev-server proxy (ng serve). Object form only — Angular's Vite dev server does NOT accept the array+function form (a function context throws and disables all proxying). Keys starting with ^ are treated as regex. Adjust target if your backend isn't on :8080.",
  "/api": { "target": "http://localhost:8080", "secure": false, "changeOrigin": true },
  "/upload": { "target": "http://localhost:8080", "secure": false, "changeOrigin": true },
  "/picture": { "target": "http://localhost:8080", "secure": false, "changeOrigin": true },
  "/export": { "target": "http://localhost:8080", "secure": false, "changeOrigin": true },
  "/unitime": { "target": "http://localhost:8080", "secure": false, "changeOrigin": true },
  "/login": { "target": "http://localhost:8080", "secure": false, "changeOrigin": true },
  "^.*\\.(action|do|jsp)(\\?.*)?$": { "target": "http://localhost:8080", "secure": false, "changeOrigin": true }
}
